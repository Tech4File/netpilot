<?xml version="1.0" encoding="utf-8"?>
<!-- VPN screen. The profile list OWNS scrolling (weight=1): a wrap_content
     RecyclerView nested in a ScrollView mis-measures on several Android
     builds and silently hides every row past the fold (v2.0.3 field bug —
     only the first three profiles were visible). Header and add-row stay
     fixed so the connection state is always on screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding"
    android:paddingBottom="@dimen/space_16">

    <!-- Master control (fixed) -->
    <app.netpilot.ui.components.FocusCardView
        android:id="@+id/vpn_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nextFocusLeft="@id/nav_rail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vpn_title"
                    style="@style/TextAppearance.NetPilot.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/vpn_description"
                    style="@style/TextAppearance.NetPilot.Body" />

                <app.netpilot.ui.components.StatusPill
                    android:id="@+id/vpn_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vpn_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:contentDescription="@string/cd_vpn_switch"
                android:minHeight="@dimen/min_target" />
        </LinearLayout>
    </app.netpilot.ui.components.FocusCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/vpn_hint_exclusive"
        style="@style/TextAppearance.NetPilot.Body" />

    <!-- Profiles (scrollable region) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginBottom="@dimen/space_12"
        android:text="@string/vpn_profiles_section"
        style="@style/TextAppearance.NetPilot.Label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vpn_profiles_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_12"
        tools:itemCount="4"
        tools:listitem="@layout/item_vpn_profile" />

    <app.netpilot.ui.components.EmptyStateView
        android:id="@+id/vpn_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:visibility="gone"
        app:npIcon="@drawable/ic_vpn"
        app:npTitle="@string/empty_vpn_title"
        app:npBody="@string/empty_vpn_body" />

    <!-- Add profile (fixed, always reachable) -->
    <app.netpilot.ui.components.FocusCardView
        android:id="@+id/vpn_add_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:nextFocusLeft="@id/nav_rail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@string/vpn_add_profile"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                app:tint="?attr/colorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:text="@string/vpn_add_profile"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary" />
        </LinearLayout>
    </app.netpilot.ui.components.FocusCardView>
</LinearLayout>
