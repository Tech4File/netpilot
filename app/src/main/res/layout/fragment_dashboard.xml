<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding"
    android:paddingBottom="@dimen/space_32"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Persistent (i): open the setup/permission guide any time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_info"
                android:layout_width="@dimen/min_target"
                android:layout_height="@dimen/min_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_open_guide"
                android:src="@drawable/ic_info"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Hero: protection status -->
        <app.netpilot.ui.components.FocusCardView
            android:id="@+id/hero_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:id="@+id/hero_icon"
                    android:layout_width="@dimen/icon_size_hero"
                    android:layout_height="@dimen/icon_size_hero"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/ic_logo_shield"
                    app:tint="@color/status_success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protection_status"
                        style="@style/TextAppearance.NetPilot.Label" />

                    <TextView
                        android:id="@+id/hero_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textSize="@dimen/text_display"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:ignore="MissingId"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <TextView
                        android:id="@+id/hero_status_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        style="@style/TextAppearance.NetPilot.Body" />

                    <app.netpilot.ui.components.StatusPill
                        android:id="@+id/hero_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12" />
                </LinearLayout>
            </LinearLayout>
        </app.netpilot.ui.components.FocusCardView>

        <!-- Quick controls -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/quick_actions_section"
            style="@style/TextAppearance.NetPilot.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <app.netpilot.ui.components.FocusCardView
                android:id="@+id/card_dns_quick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_weight="1"
                android:nextFocusLeft="@id/nav_rail">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/tab_dns"
                        android:src="@drawable/ic_dns"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/quick_dns_title"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/dns_quick_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        style="@style/TextAppearance.NetPilot.Body" />
                </LinearLayout>
            </app.netpilot.ui.components.FocusCardView>

            <app.netpilot.ui.components.FocusCardView
                android:id="@+id/card_vpn_quick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:nextFocusLeft="@id/nav_rail">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/tab_vpn"
                        android:src="@drawable/ic_vpn"
                        app:tint="?attr/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/quick_vpn_title"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/vpn_quick_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        style="@style/TextAppearance.NetPilot.Body" />
                </LinearLayout>
            </app.netpilot.ui.components.FocusCardView>
        </LinearLayout>

        <!-- One-time setup card -->
        <app.netpilot.ui.components.FocusCardView
            android:id="@+id/setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@string/setup_required_title"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/status_warning" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/setup_required_title"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/setup_required_body"
                    style="@style/TextAppearance.NetPilot.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setup_guide_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:minHeight="@dimen/min_target"
                    android:text="@string/setup_open_guide" />
            </LinearLayout>
        </app.netpilot.ui.components.FocusCardView>

        <!-- DNS + VPN coexistence advisory -->
        <app.netpilot.ui.components.FocusCardView
            android:id="@+id/advisory_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:visibility="gone"
            android:nextFocusLeft="@id/nav_rail">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/dns_vpn_advisory_title"
                    android:src="@drawable/ic_info"
                    app:tint="@color/status_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_vpn_advisory_title"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/dns_vpn_advisory_body"
                        style="@style/TextAppearance.NetPilot.Body" />
                </LinearLayout>
            </LinearLayout>
        </app.netpilot.ui.components.FocusCardView>

        <!-- Network facts -->
        <app.netpilot.ui.components.FocusCardView
            android:id="@+id/network_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:nextFocusLeft="@id/nav_rail">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/network_section"
                    style="@style/TextAppearance.NetPilot.Label" />

                <include
                    android:id="@+id/net_row_type"
                    layout="@layout/view_fact_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />

                <include
                    android:id="@+id/net_row_iface"
                    layout="@layout/view_fact_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/net_row_dns"
                    layout="@layout/view_fact_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/net_row_privdns"
                    layout="@layout/view_fact_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </app.netpilot.ui.components.FocusCardView>
    </LinearLayout>
</ScrollView>
