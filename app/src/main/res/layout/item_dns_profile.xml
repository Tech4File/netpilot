<?xml version="1.0" encoding="utf-8"?>
<app.netpilot.ui.components.FocusCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:nextFocusLeft="@id/nav_rail">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/profile_radio"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/radio_dot"
            android:contentDescription="@string/cd_status_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/TextAppearance.NetPilot.Body" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_edit"
            style="@style/Widget.NetPilot.IconButton"
            android:layout_width="@dimen/min_target"
            android:layout_height="@dimen/min_target"
            android:contentDescription="@string/cd_edit_profile"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/Widget.NetPilot.IconButton"
            android:layout_width="@dimen/min_target"
            android:layout_height="@dimen/min_target"
            android:layout_marginStart="@dimen/space_4"
            android:contentDescription="@string/cd_delete_profile"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_danger" />
    </LinearLayout>
</app.netpilot.ui.components.FocusCardView>
