<?xml version="1.0" encoding="utf-8"?>
<!-- NetPilot manifest.

     Security posture:
      * WRITE_SECURE_SETTINGS is declared but NOT install-time obtainable; it is
        granted once by the device owner over ADB (see in-app Setup guide).
      * The VPN service is protected by the platform's BIND_VPN_SERVICE permission,
        which only the system can hold.
      * Cleartext HTTP is disabled application-wide. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Granted once via: adb shell pm grant app.netpilot android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional "Reconnect VPN after restart" (Settings, default OFF).
         Protected system broadcast — the receiver runs once per power-on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The app is designed for Android TV but must also install on phones/tablets. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- Shizuku (optional grant path without ADB) - package visibility on API 30+ -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <provider android:authorities="rikka.shizuku.provider" />
    </queries>

    <!-- OpenVPN engine apps: NetPilot hands profiles to the official engine
         (de.blinkt.openvpn) and detects OpenVPN Connect. Visibility is
         required to query/install-check them on API 30+. -->
    <queries>
        <package android:name="de.blinkt.openvpn" />
        <package android:name="net.openvpn.openvpn" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-openvpn-profile" />
        </intent>
    </queries>

    <!-- Per-app VPN (v2.2.0): the picker lists LAUNCHABLE apps. This intent
         visibility query is what makes them discoverable on Android 10+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NetPilotApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetPilot"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android TV home screen entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Static app shortcuts (long-press icon): zero background cost. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The embedded WireGuard engine's VpnService is declared by the
             official tunnel library's own manifest (BIND_VPN_SERVICE-
             protected) — the engine runs inside NetPilot, one app total. -->

        <!-- Shizuku provider bridge (only used when the user opts in via Shizuku) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".ui.licenses.LicensesActivity"
            android:exported="false"
            android:label="@string/licenses_title"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".core.vpn.SecureDnsVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS-over-TLS protection tunnel (zero-setup secure DNS)" />
        </service>

        <service
            android:name=".core.vpn.NetPilotVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- targetSdk 34+ requires a documented use case for specialUse FGS type. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="OpenVPN-compatible tunnel engine transport for user-supplied VPN profiles" />
        </service>
        <!-- Standalone host of the unified status notification (platform IKEv2 /
             strict-Private-DNS states have no classic service to host it). -->
        <service
            android:name=".core.status.VpnStatusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- targetSdk 34+ requires a documented use case for specialUse FGS type. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent status indicator with one-tap turn-off for the user's active VPN and Private DNS protection" />
        </service>

        <!-- The notification's Turn off action receiver. -->
        <receiver
            android:name=".core.status.StatusActionReceiver"
            android:exported="false" />

        <!-- Quick Settings tile (one-tap Private DNS toggle). Boundaryless:
             the system binds it only while visible/tapped — zero background
             footprint (see docs/PERFORMANCE.md). -->
        <service
            android:name=".core.tiles.DnsTileService"
            android:exported="true"
            android:icon="@drawable/ic_dns"
            android:label="@string/tile_dns_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile (one-tap VPN toggle, v2.2.0). Boundaryless
             like the DNS tile. -->
        <service
            android:name=".core.tiles.VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_vpn"
            android:label="@string/tile_vpn_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- One-shot reconnect of the last embedded WireGuard tunnel after a
             restart (Settings opt-in, default OFF). Fires ONCE per power-on:
             no scheduler, no retry, no listening afterwards. -->
        <receiver
            android:name=".core.boot.BootReconnectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Hand-off area: .ovpn files sent to the engine app for import.
             Exported=false; read access is granted per-intent at hand-off. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.enginehandoff"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
